[Unit]
Description=GarcArzP HUB - CloakHub Link Cloaking & Bio Engine
After=network.target

[Service]
Type=simple
User=patrik
WorkingDirectory=/home/patrik/server/CloakHub
Environment="PATH=/home/patrik/server/CloakHub/venv/bin:/usr/local/bin:/usr/bin"
Environment="CLOAK_PORT=5100"
Environment="CLOAK_HOST=127.0.0.1"
ExecStart=/home/patrik/server/CloakHub/venv/bin/python app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
