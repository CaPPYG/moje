# ─────────────────────────────────────────────────
#  BrainDump — Environment Variables
#  Skopíruj ako .env a vyplň svoje hodnoty
# ─────────────────────────────────────────────────

# LLM API kľúče (aspoň jeden je povinný)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=                             # voliteľné (fallback)

# Server
PORT=5090
HOST=127.0.0.1

# Databáza
DB_PATH=/home/patrik/server/BrainDump/braindump.db

# CORS (čiarkou oddelené origins)
ALLOWED_ORIGINS=https://garcarzp.online,http://localhost:3000
